<?xml version="1.0" ?>
<!--
  Four-module swerve on Kraken X60.

  GENERATED by sim/worlds/gen_swerve.py. To change the robot, change the
  script and run it again, not this file.

  Each module is TWO joints: a steering one about Z (the whole module
  body rotates) and a drive one about the wheel's axle. The wheel link
  hangs from the steering one and not from the chassis, because turning
  the steering has to drag the wheel along with it.

  The steering joints have NO stop and NO spring: with zero torque they
  are free and lateral forces move them, just like a real module with no
  current. The robot code has to close the position loop.
  sim/bridge/fake-robot.py does it with a P so it can be tested.

  No perimeter walls: a collision <plane> is infinite and the <size>
  only draws, so the robot can drive off the field.
-->
<sdf version="1.11">
  <world name="mars">

    <physics name="250hz" type="ignored">
      <max_step_size>0.004</max_step_size>
      <real_time_factor>0</real_time_factor>
    </physics>

    <plugin filename="gz-sim-physics-system" name="gz::sim::systems::Physics"/>
    <plugin filename="gz-sim-user-commands-system" name="gz::sim::systems::UserCommands"/>
    <plugin filename="gz-sim-scene-broadcaster-system" name="gz::sim::systems::SceneBroadcaster"/>

    <gravity>0 0 -9.8</gravity>

    <light type="directional" name="sun">
      <pose>0 0 10 0 0 0</pose>
      <diffuse>0.8 0.8 0.8 1</diffuse>
      <direction>-0.5 0.1 -0.9</direction>
    </light>

    <model name="ground_plane">
      <static>true</static>
      <link name="link">
        <collision name="collision">
          <geometry><plane><normal>0 0 1</normal></plane></geometry>
          <surface><friction><ode><mu>0.9</mu><mu2>0.9</mu2></ode></friction></surface>
        </collision>
      </link>
    </model>

    <model name="frc_field">
      <static>true</static>
      <pose>0 0 0 1.570796 0 0</pose>
      <link name="link">
        <visual name="visual">
          <cast_shadows>false</cast_shadows>
          <geometry><mesh><uri>fields/2026-rebuilt/model.glb</uri></mesh></geometry>
        </visual>
      </link>
    </model>

    <model name="robot">
      <pose>0 0 0 0 0 0</pose>

      <link name="chassis">
        <pose>0 0 0.2 0 0 0</pose>
        <inertial>
          <mass>45.0</mass>
          <inertia><ixx>2.0284</ixx><iyy>2.0284</iyy><izz>3.8880</izz>
            <ixy>0</ixy><ixz>0</ixz><iyz>0</iyz></inertia>
        </inertial>
        <collision name="collision"><geometry><box><size>0.72 0.72 0.15</size></box></geometry></collision>
        <visual name="visual">
          <geometry><box><size>0.72 0.72 0.15</size></box></geometry>
          <material>
            <ambient>0.35 0.15 0.06 1</ambient>
            <diffuse>0.91 0.39 0.16 1</diffuse>
            <specular>0.3 0.3 0.3 1</specular>
          </material>
        </visual>
      </link>

      <!-- module fl -->
      <link name="fl_steer">
        <pose>0.2757 0.2757 0.12 0 0 0</pose>
        <inertial>
          <mass>1.2</mass>
          <inertia><ixx>0.015346</ixx><iyy>0.015346</iyy><izz>0.030091</izz>
            <ixy>0</ixy><ixz>0</ixz><iyz>0</iyz></inertia>
        </inertial>
        <visual name="visual">
          <geometry><cylinder><radius>0.05</radius><length>0.12</length></cylinder></geometry>
          <material><ambient>0.25 0.26 0.3 1</ambient><diffuse>0.62 0.65 0.72 1</diffuse></material>
        </visual>
      </link>

      <link name="fl_wheel">
        <pose>0.2757 0.2757 0.0508 -1.5707963 0 0</pose>
        <inertial>
          <mass>0.8</mass>
          <inertia><ixx>0.001122</ixx><iyy>0.001122</iyy><izz>0.002200</izz>
            <ixy>0</ixy><ixz>0</ixz><iyz>0</iyz></inertia>
        </inertial>
        <collision name="collision">
          <geometry><cylinder><radius>0.0508</radius><length>0.045</length></cylinder></geometry>
          <surface><friction><ode><mu>1.1</mu><mu2>1.1</mu2></ode></friction></surface>
        </collision>
        <visual name="visual">
          <geometry><cylinder><radius>0.0508</radius><length>0.045</length></cylinder></geometry>
          <material><ambient>0.05 0.05 0.06 1</ambient><diffuse>0.13 0.13 0.15 1</diffuse></material>
        </visual>
      </link>

      <joint name="fl_steer_joint" type="revolute">
        <parent>chassis</parent><child>fl_steer</child>
        <axis><xyz>0 0 1</xyz>
          <dynamics><damping>1.5</damping></dynamics>
          <limit><lower>-1e16</lower><upper>1e16</upper></limit></axis>
      </joint>
      <joint name="fl_drive_joint" type="revolute">
        <parent>fl_steer</parent><child>fl_wheel</child>
        <axis><xyz>0 0 1</xyz>
          <dynamics><damping>0.02</damping></dynamics>
          <limit><lower>-1e16</lower><upper>1e16</upper></limit></axis>
      </joint>

      <!-- module fr -->
      <link name="fr_steer">
        <pose>0.2757 -0.2757 0.12 0 0 0</pose>
        <inertial>
          <mass>1.2</mass>
          <inertia><ixx>0.015346</ixx><iyy>0.015346</iyy><izz>0.030091</izz>
            <ixy>0</ixy><ixz>0</ixz><iyz>0</iyz></inertia>
        </inertial>
        <visual name="visual">
          <geometry><cylinder><radius>0.05</radius><length>0.12</length></cylinder></geometry>
          <material><ambient>0.25 0.26 0.3 1</ambient><diffuse>0.62 0.65 0.72 1</diffuse></material>
        </visual>
      </link>

      <link name="fr_wheel">
        <pose>0.2757 -0.2757 0.0508 -1.5707963 0 0</pose>
        <inertial>
          <mass>0.8</mass>
          <inertia><ixx>0.001122</ixx><iyy>0.001122</iyy><izz>0.002200</izz>
            <ixy>0</ixy><ixz>0</ixz><iyz>0</iyz></inertia>
        </inertial>
        <collision name="collision">
          <geometry><cylinder><radius>0.0508</radius><length>0.045</length></cylinder></geometry>
          <surface><friction><ode><mu>1.1</mu><mu2>1.1</mu2></ode></friction></surface>
        </collision>
        <visual name="visual">
          <geometry><cylinder><radius>0.0508</radius><length>0.045</length></cylinder></geometry>
          <material><ambient>0.05 0.05 0.06 1</ambient><diffuse>0.13 0.13 0.15 1</diffuse></material>
        </visual>
      </link>

      <joint name="fr_steer_joint" type="revolute">
        <parent>chassis</parent><child>fr_steer</child>
        <axis><xyz>0 0 1</xyz>
          <dynamics><damping>1.5</damping></dynamics>
          <limit><lower>-1e16</lower><upper>1e16</upper></limit></axis>
      </joint>
      <joint name="fr_drive_joint" type="revolute">
        <parent>fr_steer</parent><child>fr_wheel</child>
        <axis><xyz>0 0 1</xyz>
          <dynamics><damping>0.02</damping></dynamics>
          <limit><lower>-1e16</lower><upper>1e16</upper></limit></axis>
      </joint>

      <!-- module bl -->
      <link name="bl_steer">
        <pose>-0.2757 0.2757 0.12 0 0 0</pose>
        <inertial>
          <mass>1.2</mass>
          <inertia><ixx>0.015346</ixx><iyy>0.015346</iyy><izz>0.030091</izz>
            <ixy>0</ixy><ixz>0</ixz><iyz>0</iyz></inertia>
        </inertial>
        <visual name="visual">
          <geometry><cylinder><radius>0.05</radius><length>0.12</length></cylinder></geometry>
          <material><ambient>0.25 0.26 0.3 1</ambient><diffuse>0.62 0.65 0.72 1</diffuse></material>
        </visual>
      </link>

      <link name="bl_wheel">
        <pose>-0.2757 0.2757 0.0508 -1.5707963 0 0</pose>
        <inertial>
          <mass>0.8</mass>
          <inertia><ixx>0.001122</ixx><iyy>0.001122</iyy><izz>0.002200</izz>
            <ixy>0</ixy><ixz>0</ixz><iyz>0</iyz></inertia>
        </inertial>
        <collision name="collision">
          <geometry><cylinder><radius>0.0508</radius><length>0.045</length></cylinder></geometry>
          <surface><friction><ode><mu>1.1</mu><mu2>1.1</mu2></ode></friction></surface>
        </collision>
        <visual name="visual">
          <geometry><cylinder><radius>0.0508</radius><length>0.045</length></cylinder></geometry>
          <material><ambient>0.05 0.05 0.06 1</ambient><diffuse>0.13 0.13 0.15 1</diffuse></material>
        </visual>
      </link>

      <joint name="bl_steer_joint" type="revolute">
        <parent>chassis</parent><child>bl_steer</child>
        <axis><xyz>0 0 1</xyz>
          <dynamics><damping>1.5</damping></dynamics>
          <limit><lower>-1e16</lower><upper>1e16</upper></limit></axis>
      </joint>
      <joint name="bl_drive_joint" type="revolute">
        <parent>bl_steer</parent><child>bl_wheel</child>
        <axis><xyz>0 0 1</xyz>
          <dynamics><damping>0.02</damping></dynamics>
          <limit><lower>-1e16</lower><upper>1e16</upper></limit></axis>
      </joint>

      <!-- module br -->
      <link name="br_steer">
        <pose>-0.2757 -0.2757 0.12 0 0 0</pose>
        <inertial>
          <mass>1.2</mass>
          <inertia><ixx>0.015346</ixx><iyy>0.015346</iyy><izz>0.030091</izz>
            <ixy>0</ixy><ixz>0</ixz><iyz>0</iyz></inertia>
        </inertial>
        <visual name="visual">
          <geometry><cylinder><radius>0.05</radius><length>0.12</length></cylinder></geometry>
          <material><ambient>0.25 0.26 0.3 1</ambient><diffuse>0.62 0.65 0.72 1</diffuse></material>
        </visual>
      </link>

      <link name="br_wheel">
        <pose>-0.2757 -0.2757 0.0508 -1.5707963 0 0</pose>
        <inertial>
          <mass>0.8</mass>
          <inertia><ixx>0.001122</ixx><iyy>0.001122</iyy><izz>0.002200</izz>
            <ixy>0</ixy><ixz>0</ixz><iyz>0</iyz></inertia>
        </inertial>
        <collision name="collision">
          <geometry><cylinder><radius>0.0508</radius><length>0.045</length></cylinder></geometry>
          <surface><friction><ode><mu>1.1</mu><mu2>1.1</mu2></ode></friction></surface>
        </collision>
        <visual name="visual">
          <geometry><cylinder><radius>0.0508</radius><length>0.045</length></cylinder></geometry>
          <material><ambient>0.05 0.05 0.06 1</ambient><diffuse>0.13 0.13 0.15 1</diffuse></material>
        </visual>
      </link>

      <joint name="br_steer_joint" type="revolute">
        <parent>chassis</parent><child>br_steer</child>
        <axis><xyz>0 0 1</xyz>
          <dynamics><damping>1.5</damping></dynamics>
          <limit><lower>-1e16</lower><upper>1e16</upper></limit></axis>
      </joint>
      <joint name="br_drive_joint" type="revolute">
        <parent>br_steer</parent><child>br_wheel</child>
        <axis><xyz>0 0 1</xyz>
          <dynamics><damping>0.02</damping></dynamics>
          <limit><lower>-1e16</lower><upper>1e16</upper></limit></axis>
      </joint>

      <!-- The ORDER is the contract: it defines the index inside
           gz.msgs.Actuators.normalized. The robot map lists its own in
           the same order and check.py verifies it.

           The robot's real reductions: 5.2734375 drive,
           26.091 steering. They come from TunerConstants.java. -->
      <plugin filename="MarsLink" name="mars::MarsLink">
        <actuator joint="fl_drive_joint" motor="kraken_x60" gearRatio="5.2734375"/>
        <actuator joint="fl_steer_joint" motor="kraken_x60" gearRatio="26.09090909090909" control="position" kp="0.08" kd="0.012"/>
        <actuator joint="fr_drive_joint" motor="kraken_x60" gearRatio="5.2734375"/>
        <actuator joint="fr_steer_joint" motor="kraken_x60" gearRatio="26.09090909090909" control="position" kp="0.08" kd="0.012"/>
        <actuator joint="bl_drive_joint" motor="kraken_x60" gearRatio="5.2734375"/>
        <actuator joint="bl_steer_joint" motor="kraken_x60" gearRatio="26.09090909090909" control="position" kp="0.08" kd="0.012"/>
        <actuator joint="br_drive_joint" motor="kraken_x60" gearRatio="5.2734375"/>
        <actuator joint="br_steer_joint" motor="kraken_x60" gearRatio="26.09090909090909" control="position" kp="0.08" kd="0.012"/>
      </plugin>
    </model>

  </world>
</sdf>
