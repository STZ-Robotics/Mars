      </joint>

      <!-- modulo br -->
      <link name="br_steer">
        <pose>-0.276225 -0.276225 0.12 0 0 0</pose>
        <inertial>
          <mass>1.2</mass>
          <inertia><ixx>0.015346</ixx><iyy>0.015346</iyy><izz>0.030091</izz>
