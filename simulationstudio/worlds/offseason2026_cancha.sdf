      </joint>

      <!-- MECANISMOS. Salen del Mechanism3D de MARS Desktop
           (RobotAnimation2.json) via convertir_mecanismo.py: el pivote, el eje
           y los limites son los de alla. Solo visual y masa: no chocan
           con nada, para que un brazo no empuje al propio robot. -->

      <!-- IntakeArm -> intake_arm (position) -->
      <link name="intake_arm">
        <pose>0.3007 0.0124 0.23 0 0 0</pose>
        <inertial>
          <pose>0.1554 -0.0125 -0.0315 0 0 0</pose>
          <mass>3.0000</mass>
          <inertia><ixx>0.147754</ixx><iyy>0.149931</iyy><izz>0.163301</izz>
            <ixy>0</ixy><ixz>0</ixz><iyz>0</iyz></inertia>
        </inertial>
        <visual name="cad">
          <pose>-0.3007 -0.0124 -0.23 0 0 0</pose>
          <geometry><mesh><uri>model://offseason2026/meshes/intakearm.stl</uri></mesh></geometry>
          <material><ambient>0.000 0.288 0.379 1</ambient><diffuse>0.000 0.639 0.843 1</diffuse><specular>0.15 0.15 0.15 1</specular></material>
        </visual>
      </link>
      <joint name="intake_arm_joint" type="revolute">
        <parent>chassis</parent><child>intake_arm</child>
        <axis><xyz>0.0 1.0 0.0</xyz>
          <dynamics><damping>0.01</damping></dynamics>
          <limit><lower>-1.919862</lower><upper>0.0</upper></limit></axis>
      </joint>

      <!-- Angulator -> dumper (position) -->
      <link name="dumper">
        <pose>-0.1993 0.0124 0.51 0 0 0</pose>
        <inertial>
          <pose>0.0811 -0.0126 0.0485 0 0 0</pose>
          <mass>1.5000</mass>
          <inertia><ixx>0.088226</ixx><iyy>0.172992</iyy><izz>0.088226</izz>
            <ixy>0</ixy><ixz>0</ixz><iyz>0</iyz></inertia>
        </inertial>
        <visual name="cad">
          <pose>0.1993 -0.0124 -0.51 0 0 0</pose>
          <geometry><mesh><uri>model://offseason2026/meshes/angulator.stl</uri></mesh></geometry>
          <material><ambient>0.180 0.275 0.094 1</ambient><diffuse>0.400 0.612 0.208 1</diffuse><specular>0.15 0.15 0.15 1</specular></material>
        </visual>
      </link>
      <joint name="dumper_joint" type="revolute">
        <parent>chassis</parent><child>dumper</child>
        <axis><xyz>0.0 1.0 0.0</xyz>
          <dynamics><damping>0.01</damping></dynamics>
          <limit><lower>0.0</lower><upper>0.872665</upper></limit></axis>
      </joint>

      <!-- Tambor -> shooter (duty) -->
      <link name="shooter">
        <pose>-0.1993 0.0124 0.51 0 0 0</pose>
        <inertial>
          <pose>0.0 0.0 0.0 0 0 0</pose>
          <mass>1.2000</mass>
          <inertia><ixx>0.037067</ixx><iyy>0.002155</iyy><izz>0.037064</izz>
