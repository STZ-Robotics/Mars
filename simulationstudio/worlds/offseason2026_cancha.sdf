      </joint>

      <!-- El ORDEN es el contrato: define el indice dentro de
           gz.msgs.Actuators.normalized. El robot-map lista los suyos en
           el mismo orden y check.py lo verifica.

           Limite de corriente: 120 A en traccion (la de
           deslizamiento, calculada de la masa y el mu) y
           60 A en direccion.

           Reducciones reales del robot: 5.2734375 de traccion,
           26.091 de direccion. Salen de TunerConstants.java. -->
      <plugin filename="MarsLink" name="mars::MarsLink">
        <actuator joint="fl_drive_joint" motor="kraken_x60" gearRatio="5.2734375" currentLimit="120" neutralMode="brake"/>
        <actuator joint="fl_steer_joint" motor="kraken_x60" gearRatio="26.09090909090909" control="position" currentLimit="60" kp="0.9" kd="0.01"/>
        <actuator joint="fr_drive_joint" motor="kraken_x60" gearRatio="5.2734375" currentLimit="120" neutralMode="brake"/>
        <actuator joint="fr_steer_joint" motor="kraken_x60" gearRatio="26.09090909090909" control="position" currentLimit="60" kp="0.9" kd="0.01"/>
        <actuator joint="bl_drive_joint" motor="kraken_x60" gearRatio="5.2734375" currentLimit="120" neutralMode="brake"/>
        <actuator joint="bl_steer_joint" motor="kraken_x60" gearRatio="26.09090909090909" control="position" currentLimit="60" kp="0.9" kd="0.01"/>
        <actuator joint="br_drive_joint" motor="kraken_x60" gearRatio="5.2734375" currentLimit="120" neutralMode="brake"/>
        <actuator joint="br_steer_joint" motor="kraken_x60" gearRatio="26.09090909090909" control="position" currentLimit="60" kp="0.9" kd="0.01"/>
        <actuator joint="intake_arm_joint" motor="neo" gearRatio="45.0" currentLimit="40" control="position" kp="2.0" kd="0.05"/>
        <actuator joint="dumper_joint" motor="neo" gearRatio="60.0" currentLimit="40" control="position" kp="2.0" kd="0.05"/>
        <actuator joint="shooter_joint" motor="kraken_x60" gearRatio="1.0" currentLimit="120"/>
        <actuator joint="box_joint" motor="neo" gearRatio="250.0" currentLimit="40" control="position" kp="20.0" kd="0.5"/>
        <actuator joint="intake_rollers_joint" motor="kraken_x60" gearRatio="1.0" currentLimit="40"/>
        <actuator joint="indexer_rollers_joint" motor="neo" gearRatio="3.0" currentLimit="40"/>
      </plugin>
    </model>

