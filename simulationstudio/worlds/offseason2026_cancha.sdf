      <joint name="shooter_joint" type="revolute">
        <parent>chassis</parent><child>shooter</child>
        <axis><xyz>0.0 1.0 0.0</xyz>
          <dynamics><damping>0.0005</damping><friction>0.03</friction></dynamics>
          <limit><lower>-1e+16</lower><upper>1e+16</upper></limit></axis>
      </joint>

      <!-- Box -> box (position) -->
      <link name="box">
        <pose>-0.0193 0.0124 0.48 0 0 0</pose>
        <inertial>
          <pose>0.2103 -0.0121 0.0467 0 0 0</pose>
