      <pose>-0.8382 0.7112 0.0765 0 0 0</pose>
    </include>
    <include>
      <uri>model://fuel</uri>
      <name>fuel_008</name>
      <pose>-0.8382 -0.7112 0.0753 0 0 0</pose>
    </include>
    <include>
      <uri>model://fuel</uri>
      <name>fuel_009</name>
      <pose>-0.5334 0.4064 0.0765 0 0 0</pose>
    </include>
    <include>
      <uri>model://fuel</uri>
      <name>fuel_010</name>
      <pose>-0.5334 -0.4064 0.0753 0 0 0</pose>
    </include>
    <include>
      <uri>model://fuel</uri>
      <name>fuel_011</name>
      <pose>-0.3810 -0.1016 0.0753 0 0 0</pose>
    </include>
    <include>
