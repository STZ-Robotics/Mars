      <!-- modulo bl -->
      <link name="bl_steer">
        <pose>-0.276225 0.276225 0.12 0 0 0</pose>
        <inertial>
          <mass>1.2</mass>
          <inertia><ixx>0.015346</ixx><iyy>0.015346</iyy><izz>0.030091</izz>
            <ixy>0</ixy><ixz>0</ixz><iyz>0</iyz></inertia>
        </inertial>
      </link>

      <link name="bl_wheel">
        <pose>-0.276225 0.276225 0.0508 -1.5707963 0 0</pose>
        <inertial>
          <mass>0.8</mass>
          <inertia><ixx>0.001122</ixx><iyy>0.001122</iyy><izz>0.002200</izz>
