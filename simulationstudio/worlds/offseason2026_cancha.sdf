<?xml version="1.0" ?>
<!--
  Swerve de cuatro modulos sobre Kraken X60.

  GENERADO por sim/worlds/gen_swerve.py. Para cambiar el robot se toca el
  script y se vuelve a correr, no este archivo.

  Cada modulo son DOS joints: uno de direccion sobre Z (el cuerpo del
  modulo gira entero) y uno de traccion sobre el eje de la rueda. El link
  de la rueda cuelga del de direccion y no del chasis, porque girar la
  direccion tiene que arrastrar la rueda con ella.

  Las direcciones NO tienen tope ni resorte: con par cero quedan libres y
  las fuerzas laterales las mueven, igual que un modulo real sin
  corriente. El codigo del robot tiene que cerrar el lazo de posicion.
  sim/bridge/fake-robot.py lo hace con un P para poder probarlo.

  Los limites de la cancha son cajas de colision sacadas del modelo
  oficial: guardrails, los seis driver stations, las torres, los
  outposts y los dos HUB. Se apagan con HITBOXES en el generador.
-->
<sdf version="1.11">
  <world name="mars">

    <physics name="250hz" type="ignored">
      <max_step_size>0.004</max_step_size>
      <real_time_factor>1.0</real_time_factor>
    </physics>

    <plugin filename="gz-sim-physics-system" name="gz::sim::systems::Physics"/>
    <plugin filename="gz-sim-user-commands-system" name="gz::sim::systems::UserCommands"/>
    <plugin filename="gz-sim-scene-broadcaster-system" name="gz::sim::systems::SceneBroadcaster"/>
    <plugin filename="gz-sim-apply-link-wrench-system" name="gz::sim::systems::ApplyLinkWrench"/>

    <gravity>0 0 -9.8</gravity>

    <light type="directional" name="sun">
      <pose>0 0 10 0 0 0</pose>
      <diffuse>0.8 0.8 0.8 1</diffuse>
      <direction>-0.5 0.1 -0.9</direction>
    </light>

    <model name="ground_plane">
      <static>true</static>
      <link name="link">
        <collision name="collision">
          <geometry><plane><normal>0 0 1</normal></plane></geometry>
          <surface><friction><ode><mu>0.9</mu><mu2>0.9</mu2></ode></friction></surface>
        </collision>
      </link>
    </model>

    <model name="frc_field">
      <static>true</static>
      <pose>0 0 0 1.570796 0 0</pose>
      <link name="link">
        <visual name="visual">
          <cast_shadows>false</cast_shadows>
          <geometry><mesh><uri>fields/2026-rebuilt/model-lite.glb</uri></mesh></geometry>
        </visual>
      </link>
    </model>

    <!-- La FISICA de la cancha: la malla de arriba no tiene colision
         ninguna, asi que sin estas cajas el robot atraviesa la pared
         de la estacion y el HUB conduciendo.

         Las medidas salen de los AABB de los nodos del glTF oficial,
         no de una tabla a mano. Cuales entran y por que el trench y
         los bumps NO estan: worlds/cancha_2026.py. -->
    <model name="field_collision">
      <static>true</static>
      <link name="link">
        <collision name="guardrail_1">
          <pose>-0.0000 4.1927 0.2611 0.00000 0.00000 0.00000</pose>
          <geometry><box><size>16.6372 0.3580 0.5237</size></box></geometry>
        </collision>
        <collision name="guardrail_2">
          <pose>0.0000 -4.1927 0.2611 0.00000 0.00000 0.00000</pose>
          <geometry><box><size>16.6372 0.3580 0.5237</size></box></geometry>
        </collision>
        <collision name="driver_station_1">
          <pose>-8.4467 3.0798 0.9949 0.00000 0.00000 0.00000</pose>
          <geometry><box><size>0.3810 1.8288 1.9853</size></box></geometry>
        </collision>
        <collision name="driver_station_2">
          <pose>-8.4467 1.2510 0.9949 0.00000 0.00000 0.00000</pose>
          <geometry><box><size>0.3810 1.8288 1.9853</size></box></geometry>
        </collision>
        <collision name="driver_station_3">
          <pose>-8.4467 -1.8288 0.9949 0.00000 0.00000 0.00000</pose>
          <geometry><box><size>0.3810 1.8288 1.9853</size></box></geometry>
        </collision>
        <collision name="driver_station_4">
          <pose>8.4467 1.8288 0.9949 0.00000 0.00000 0.00000</pose>
          <geometry><box><size>0.3810 1.8288 1.9853</size></box></geometry>
        </collision>
        <collision name="driver_station_5">
          <pose>8.4467 -1.2510 0.9949 0.00000 0.00000 0.00000</pose>
          <geometry><box><size>0.3810 1.8288 1.9853</size></box></geometry>
        </collision>
        <collision name="driver_station_6">
          <pose>8.4467 -3.0798 0.9949 0.00000 0.00000 0.00000</pose>
          <geometry><box><size>0.3810 1.8288 1.9853</size></box></geometry>
        </collision>
        <collision name="tower_1">
          <pose>-7.7285 -0.2889 0.9956 0.00000 0.00000 0.00000</pose>
          <geometry><box><size>1.2050 1.2509 1.9911</size></box></geometry>
        </collision>
        <collision name="tower_2">
          <pose>7.7285 0.2889 0.9956 0.00000 0.00000 0.00000</pose>
          <geometry><box><size>1.2050 1.2509 1.9911</size></box></geometry>
        </collision>
        <collision name="outpost_1">
          <pose>-8.7156 -3.4592 0.9955 0.00000 0.00000 0.00000</pose>
          <geometry><box><size>1.0247 1.4319 1.9909</size></box></geometry>
        </collision>
        <collision name="outpost_2">
          <pose>8.7156 3.4592 0.9955 0.00000 0.00000 0.00000</pose>
          <geometry><box><size>1.0247 1.4319 1.9909</size></box></geometry>
        </collision>
        <collision name="hub_1">
          <pose>-3.4933 0.0051 1.5407 0.00000 0.00000 0.00000</pose>
          <geometry><box><size>1.5306 1.4947 3.0814</size></box></geometry>
        </collision>
        <collision name="hub_2">
          <pose>3.4933 -0.0051 1.5407 0.00000 0.00000 0.00000</pose>
          <geometry><box><size>1.5306 1.4947 3.0814</size></box></geometry>
        </collision>
        <collision name="bump_1_1">
          <pose>-3.9155 -1.6345 0.0443 0.00000 -0.28539 0.00000</pose>
          <geometry><box><size>0.5876 2.2333 0.0800</size></box></geometry>
        </collision>
        <collision name="bump_1_2">
          <pose>-3.3743 -1.6345 0.0443 0.00000 0.28539 0.00000</pose>
          <geometry><box><size>0.5876 2.2333 0.0800</size></box></geometry>
        </collision>
        <collision name="bump_2_1">
          <pose>-3.9155 1.6345 0.0443 0.00000 -0.28539 0.00000</pose>
          <geometry><box><size>0.5876 2.2333 0.0800</size></box></geometry>
        </collision>
        <collision name="bump_2_2">
          <pose>-3.3743 1.6345 0.0443 0.00000 0.28539 0.00000</pose>
          <geometry><box><size>0.5876 2.2333 0.0800</size></box></geometry>
        </collision>
        <collision name="bump_3_1">
          <pose>3.3743 -1.6345 0.0443 0.00000 -0.28539 0.00000</pose>
          <geometry><box><size>0.5876 2.2333 0.0800</size></box></geometry>
        </collision>
        <collision name="bump_3_2">
          <pose>3.9155 -1.6345 0.0443 0.00000 0.28539 0.00000</pose>
          <geometry><box><size>0.5876 2.2333 0.0800</size></box></geometry>
        </collision>
        <collision name="bump_4_1">
          <pose>3.3743 1.6345 0.0443 0.00000 -0.28539 0.00000</pose>
          <geometry><box><size>0.5876 2.2333 0.0800</size></box></geometry>
        </collision>
        <collision name="bump_4_2">
          <pose>3.9155 1.6345 0.0443 0.00000 0.28539 0.00000</pose>
          <geometry><box><size>0.5876 2.2333 0.0800</size></box></geometry>
        </collision>
      </link>
    </model>

    <!-- 12 FUEL con fisica, en el sitio exacto en el que la
         malla de la cancha las dibujaba: las posiciones salen de los
         nodos del glTF, no de una tabla escrita a mano. Son las mas
         cercanas al spawn del robot; las del feeder no estan.

         Cada una es un cuerpo dinamico: con 408 el mundo va a medio
         tiempo real y no se puede conducir. La cuenta esta en FUEL,
         en gen_swerve.py. -->
    <include>
      <uri>model://fuel</uri>
      <name>fuel_001</name>
      <pose>-0.5334 0.1016 0.0765 0 0 0</pose>
    </include>
    <include>
      <uri>model://fuel</uri>
      <name>fuel_002</name>
      <pose>-0.5334 -0.1016 0.0753 0 0 0</pose>
    </include>
    <include>
      <uri>model://fuel</uri>
      <name>fuel_003</name>
      <pose>-0.5334 0.2540 0.0765 0 0 0</pose>
    </include>
    <include>
      <uri>model://fuel</uri>
      <name>fuel_004</name>
      <pose>-0.5334 -0.2540 0.0753 0 0 0</pose>
    </include>
    <include>
      <uri>model://fuel</uri>
      <name>fuel_005</name>
      <pose>-0.6858 0.5588 0.0765 0 0 0</pose>
    </include>
    <include>
      <uri>model://fuel</uri>
      <name>fuel_006</name>
      <pose>-0.6858 -0.5588 0.0753 0 0 0</pose>
    </include>
    <include>
