        <axis><xyz>0 0 1</xyz>
          <dynamics><damping>0.05</damping></dynamics>
          <limit><lower>-1e16</lower><upper>1e16</upper></limit></axis>
      </joint>
      <joint name="fr_drive_joint" type="revolute">
        <parent>fr_steer</parent><child>fr_wheel</child>
        <axis><xyz>0 0 1</xyz>
          <dynamics><damping>0.004</damping></dynamics>
          <limit><lower>-1e16</lower><upper>1e16</upper></limit></axis>
