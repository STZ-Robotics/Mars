<?xml version="1.0" ?>
<!--
  Test robot: a 40 kg chassis and four driven wheels, with no steering.

  It is skid-steer and not swerve on purpose. With four joints instead of
  eight, and no steering loop, it tests exactly the same of the protocol
  (commands go in, torque is applied, state comes out) with half the surface
  to get wrong. The swerve comes once this loop is closed.

  The robot is defined inside the world instead of in sim/models/ so as not
  to depend on GZ_SIM_RESOURCE_PATH yet: one less environment variable that
  can be set wrong while the loop is being debugged.
-->
<sdf version="1.11">
  <world name="mars">

    <physics name="250hz" type="ignored">
      <max_step_size>0.004</max_step_size>
      <real_time_factor>1.0</real_time_factor>
    </physics>

    <plugin filename="gz-sim-physics-system"
            name="gz::sim::systems::Physics"/>
    <plugin filename="gz-sim-user-commands-system"
            name="gz::sim::systems::UserCommands"/>
    <plugin filename="gz-sim-scene-broadcaster-system"
            name="gz::sim::systems::SceneBroadcaster"/>

    <gravity>0 0 -9.8</gravity>

    <light type="directional" name="sun">
      <pose>0 0 10 0 0 0</pose>
      <diffuse>0.8 0.8 0.8 1</diffuse>
      <direction>-0.5 0.1 -0.9</direction>
    </light>

    <!--
      No perimeter walls yet. The visual's <size> draws the field, but a
      COLLISION <plane> is infinite, so the robot can drive off the field and
      nothing stops it. For testing the loop it does not matter; simulating a
      match will need the perimeter.
    -->
    <model name="ground_plane">
      <static>true</static>
      <link name="link">
        <collision name="collision">
          <geometry><plane><normal>0 0 1</normal></plane></geometry>
          <surface>
            <friction><ode><mu>0.9</mu><mu2>0.9</mu2></ode></friction>
          </surface>
        </collision>
        <visual name="visual">
          <geometry>
            <plane><normal>0 0 1</normal><size>16.54 8.21</size></plane>
          </geometry>
          <material>
            <ambient>0.2 0.2 0.2 1</ambient>
            <diffuse>0.3 0.3 0.3 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <model name="robot">
      <pose>0 0 0 0 0 0</pose>

      <link name="chassis">
        <pose>0 0 0.15 0 0 0</pose>
        <inertial>
          <mass>40.0</mass>
          <!-- A 0.7 x 0.6 x 0.15 box: I = m/12 * (a^2 + b^2) per axis. -->
          <inertia>
            <ixx>1.275</ixx><iyy>1.708</iyy><izz>2.833</izz>
            <ixy>0</ixy><ixz>0</ixz><iyz>0</iyz>
          </inertia>
        </inertial>
        <collision name="collision">
          <geometry><box><size>0.7 0.6 0.15</size></box></geometry>
        </collision>
        <visual name="visual">
          <geometry><box><size>0.7 0.6 0.15</size></box></geometry>
          <material>
            <ambient>0.1 0.1 0.12 1</ambient>
            <diffuse>0.15 0.16 0.2 1</diffuse>
          </material>
        </visual>
      </link>

      <!-- 3 inch wheels (r = 0.0762 m), 1 kg. A cylinder with its axis on
           Y: I_axial = m*r^2/2, I_perp = m*(3r^2 + h^2)/12. -->
      <link name="fl_wheel">
        <pose>0.25 0.3 0.0762 -1.5707963 0 0</pose>
        <inertial>
          <mass>1.0</mass>
          <inertia>
            <ixx>0.00166</ixx><iyy>0.00166</iyy><izz>0.0029</izz>
            <ixy>0</ixy><ixz>0</ixz><iyz>0</iyz>
          </inertia>
        </inertial>
        <collision name="collision">
          <geometry><cylinder><radius>0.0762</radius><length>0.05</length></cylinder></geometry>
          <surface>
            <friction><ode><mu>1.1</mu><mu2>1.1</mu2></ode></friction>
          </surface>
        </collision>
        <visual name="visual">
          <geometry><cylinder><radius>0.0762</radius><length>0.05</length></cylinder></geometry>
          <material><diffuse>0.8 0.35 0.1 1</diffuse></material>
        </visual>
      </link>

      <link name="fr_wheel">
        <pose>0.25 -0.3 0.0762 -1.5707963 0 0</pose>
        <inertial>
          <mass>1.0</mass>
          <inertia>
            <ixx>0.00166</ixx><iyy>0.00166</iyy><izz>0.0029</izz>
            <ixy>0</ixy><ixz>0</ixz><iyz>0</iyz>
          </inertia>
        </inertial>
        <collision name="collision">
          <geometry><cylinder><radius>0.0762</radius><length>0.05</length></cylinder></geometry>
          <surface>
            <friction><ode><mu>1.1</mu><mu2>1.1</mu2></ode></friction>
          </surface>
        </collision>
        <visual name="visual">
          <geometry><cylinder><radius>0.0762</radius><length>0.05</length></cylinder></geometry>
          <material><diffuse>0.8 0.35 0.1 1</diffuse></material>
        </visual>
      </link>

      <link name="bl_wheel">
        <pose>-0.25 0.3 0.0762 -1.5707963 0 0</pose>
        <inertial>
          <mass>1.0</mass>
          <inertia>
            <ixx>0.00166</ixx><iyy>0.00166</iyy><izz>0.0029</izz>
            <ixy>0</ixy><ixz>0</ixz><iyz>0</iyz>
          </inertia>
        </inertial>
        <collision name="collision">
          <geometry><cylinder><radius>0.0762</radius><length>0.05</length></cylinder></geometry>
          <surface>
            <friction><ode><mu>1.1</mu><mu2>1.1</mu2></ode></friction>
          </surface>
        </collision>
        <visual name="visual">
          <geometry><cylinder><radius>0.0762</radius><length>0.05</length></cylinder></geometry>
          <material><diffuse>0.8 0.35 0.1 1</diffuse></material>
        </visual>
      </link>

      <link name="br_wheel">
        <pose>-0.25 -0.3 0.0762 -1.5707963 0 0</pose>
        <inertial>
          <mass>1.0</mass>
          <inertia>
            <ixx>0.00166</ixx><iyy>0.00166</iyy><izz>0.0029</izz>
            <ixy>0</ixy><ixz>0</ixz><iyz>0</iyz>
          </inertia>
        </inertial>
        <collision name="collision">
          <geometry><cylinder><radius>0.0762</radius><length>0.05</length></cylinder></geometry>
          <surface>
            <friction><ode><mu>1.1</mu><mu2>1.1</mu2></ode></friction>
          </surface>
        </collision>
        <visual name="visual">
          <geometry><cylinder><radius>0.0762</radius><length>0.05</length></cylinder></geometry>
          <material><diffuse>0.8 0.35 0.1 1</diffuse></material>
        </visual>
      </link>

      <!-- The axis is the wheel link's Z, which the <pose>'s -90 degree
           rotation about X leaves pointing along the robot's Y. -->
      <joint name="fl_drive_joint" type="revolute">
        <parent>chassis</parent><child>fl_wheel</child>
        <axis><xyz>0 0 1</xyz><limit><lower>-1e16</lower><upper>1e16</upper></limit></axis>
      </joint>
      <joint name="fr_drive_joint" type="revolute">
        <parent>chassis</parent><child>fr_wheel</child>
        <axis><xyz>0 0 1</xyz><limit><lower>-1e16</lower><upper>1e16</upper></limit></axis>
      </joint>
      <joint name="bl_drive_joint" type="revolute">
        <parent>chassis</parent><child>bl_wheel</child>
        <axis><xyz>0 0 1</xyz><limit><lower>-1e16</lower><upper>1e16</upper></limit></axis>
      </joint>
      <joint name="br_drive_joint" type="revolute">
        <parent>chassis</parent><child>br_wheel</child>
        <axis><xyz>0 0 1</xyz><limit><lower>-1e16</lower><upper>1e16</upper></limit></axis>
      </joint>

      <!-- The ORDER of these <actuator>s is the contract: it defines the
           index inside gz.msgs.Actuators.normalized. The bridge's robot map
           lists its own in the same order and check.py verifies it.

           NO wheel is inverted. On a real robot one side is inverted because
           the motors are mounted mirrored, but here all four links have the
           same rotation (-90 degrees about X), so their axes point the same
           way and the same sign makes them roll in the same direction.
           Inverting the right side makes the robot spin in place instead of
           moving forward. -->
      <plugin filename="MarsLink" name="mars::MarsLink">
        <actuator joint="fl_drive_joint" motor="kraken_x60" gearRatio="6.75"/>
        <actuator joint="fr_drive_joint" motor="kraken_x60" gearRatio="6.75"/>
        <actuator joint="bl_drive_joint" motor="kraken_x60" gearRatio="6.75"/>
        <actuator joint="br_drive_joint" motor="kraken_x60" gearRatio="6.75"/>
      </plugin>
    </model>

  </world>
</sdf>
