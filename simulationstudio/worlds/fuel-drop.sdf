<?xml version="1.0" ?>
<!--
  FUEL bounce calibration.

  It exists because the restitution coefficient in models/fuel/model.sdf is
  the only number in the model that does NOT come from the manual: the manual
  gives diameter and mass, but nothing about how a high-density foam ball
  bounces on FRC carpet. It was set to 0.35 as a starting point and has to be
  measured. (Measuring it showed this gz-physics build ignores <bounce>
  entirely; see models/fuel/README.md. The friction ramp below is still the
  calibration bench for mu.)

  HOW TO USE IT
  -------------
  1. In real life: drop a FUEL from 1.00 m onto FRC carpet and see how high
     the first bounce comes back.
  2. Run this world and watch the first bounce of the leftmost ball (it also
     drops from 1.00 m).
  3. If they do not match, the coefficient you want is  e = sqrt(h_bounce / 1.00).
     Change it in models/fuel/model.sdf and repeat.

  The three balls drop from different heights on purpose: a real material's
  restitution DROPS with impact velocity, so a value that nails the bounce
  from 1 m may fall short from 2.5 m. If the three do not fit the same number,
  pick the one that matches the velocities you care about --- almost always a
  shot's, not a free fall's.

  The fourth one rolls down a ramp: it is the one that says whether the
  FRICTION is right. With the right mu it rolls; with a mu that is too low it
  slides and reaches the bottom spinning less than it should.
-->
<sdf version="1.11">
  <world name="mars">

    <physics name="250hz" type="ignored">
      <max_step_size>0.004</max_step_size>
      <real_time_factor>1.0</real_time_factor>
    </physics>

    <plugin filename="gz-sim-physics-system"
            name="gz::sim::systems::Physics"/>
    <plugin filename="gz-sim-user-commands-system"
            name="gz::sim::systems::UserCommands"/>
    <plugin filename="gz-sim-scene-broadcaster-system"
            name="gz::sim::systems::SceneBroadcaster"/>

    <gravity>0 0 -9.8</gravity>
    <scene>
      <ambient>0.7 0.7 0.7 1</ambient>
      <background>0.7 0.75 0.8 1</background>
      <shadows>true</shadows>
    </scene>

    <light type="directional" name="sun">
      <cast_shadows>true</cast_shadows>
      <pose>0 0 10 0 0 0</pose>
      <diffuse>0.8 0.8 0.8 1</diffuse>
      <specular>0.2 0.2 0.2 1</specular>
      <direction>-0.5 0.1 -0.9</direction>
    </light>

    <!-- FRC carpet, with the same mu as the match worlds: calibrating
         against a different floor from the one used afterwards is useless. -->
    <model name="ground_plane">
      <static>true</static>
      <link name="link">
        <collision name="collision">
          <geometry><plane><normal>0 0 1</normal></plane></geometry>
          <surface>
            <friction><ode><mu>0.9</mu><mu2>0.9</mu2></ode></friction>
          </surface>
        </collision>
        <visual name="visual">
          <!-- The carpet is drawn at the field's size even though only a corner
               is used here: protocol/check.py requires every plane's <size>
               to match the manifest, because a smaller plane in a match world
               means shifted poses in NT without any visible error. The
               collision one is infinite and nobody looks at it. -->
          <geometry><plane><normal>0 0 1</normal><size>16.54 8.21</size></plane></geometry>
          <material>
            <ambient>0.16 0.17 0.19 1</ambient>
            <diffuse>0.30 0.32 0.36 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <!-- Vertical ruler: marks every 10 cm up to 1 m, to read the bounce
         height by eye in the window without instrumenting anything. -->
    <model name="ruler">
      <static>true</static>
      <pose>-1.0 0.35 0 0 0 0</pose>
      <link name="link">
        <visual name="post">
          <pose>0 0 0.5 0 0 0</pose>
          <geometry><box><size>0.02 0.02 1.0</size></box></geometry>
          <material><ambient>0.2 0.2 0.2 1</ambient><diffuse>0.35 0.35 0.35 1</diffuse></material>
        </visual>
        <visual name="m10"><pose>0 0 0.10 0 0 0</pose><geometry><box><size>0.10 0.004 0.004</size></box></geometry><material><diffuse>1 1 1 1</diffuse></material></visual>
        <visual name="m20"><pose>0 0 0.20 0 0 0</pose><geometry><box><size>0.06 0.004 0.004</size></box></geometry><material><diffuse>1 1 1 1</diffuse></material></visual>
        <visual name="m30"><pose>0 0 0.30 0 0 0</pose><geometry><box><size>0.10 0.004 0.004</size></box></geometry><material><diffuse>1 1 1 1</diffuse></material></visual>
        <visual name="m40"><pose>0 0 0.40 0 0 0</pose><geometry><box><size>0.06 0.004 0.004</size></box></geometry><material><diffuse>1 1 1 1</diffuse></material></visual>
        <visual name="m50"><pose>0 0 0.50 0 0 0</pose><geometry><box><size>0.12 0.006 0.006</size></box></geometry><material><diffuse>1 0.4 0.2 1</diffuse></material></visual>
        <visual name="m60"><pose>0 0 0.60 0 0 0</pose><geometry><box><size>0.06 0.004 0.004</size></box></geometry><material><diffuse>1 1 1 1</diffuse></material></visual>
        <visual name="m70"><pose>0 0 0.70 0 0 0</pose><geometry><box><size>0.10 0.004 0.004</size></box></geometry><material><diffuse>1 1 1 1</diffuse></material></visual>
        <visual name="m80"><pose>0 0 0.80 0 0 0</pose><geometry><box><size>0.06 0.004 0.004</size></box></geometry><material><diffuse>1 1 1 1</diffuse></material></visual>
        <visual name="m90"><pose>0 0 0.90 0 0 0</pose><geometry><box><size>0.10 0.004 0.004</size></box></geometry><material><diffuse>1 1 1 1</diffuse></material></visual>
        <visual name="m100"><pose>0 0 1.00 0 0 0</pose><geometry><box><size>0.14 0.006 0.006</size></box></geometry><material><diffuse>1 0.4 0.2 1</diffuse></material></visual>
      </link>
    </model>

    <!-- The reference one: 1.00 m, the same height measured by hand. -->
    <include>
      <uri>model://fuel</uri>
      <name>fuel_drop_1m</name>
      <pose>-1.0 0 1.0 0 0 0</pose>
    </include>

    <!-- Half height and two and a half times: real restitution falls with
         impact velocity, and with three points you can see whether a single
         coefficient covers the range that matters. -->
    <include>
      <uri>model://fuel</uri>
      <name>fuel_drop_050</name>
      <pose>-0.4 0 0.5 0 0 0</pose>
    </include>
    <include>
      <uri>model://fuel</uri>
      <name>fuel_drop_250</name>
      <pose>0.2 0 2.5 0 0 0</pose>
    </include>

    <!-- A 20 degree ramp for friction: roll or slide. -->
    <model name="ramp">
      <static>true</static>
      <pose>1.6 0 0.18 0 -0.349 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry><box><size>1.2 0.5 0.04</size></box></geometry>
          <surface>
            <friction><ode><mu>0.9</mu><mu2>0.9</mu2></ode></friction>
          </surface>
        </collision>
        <visual name="visual">
          <geometry><box><size>1.2 0.5 0.04</size></box></geometry>
          <material><ambient>0.2 0.22 0.25 1</ambient><diffuse>0.45 0.48 0.55 1</diffuse></material>
        </visual>
      </link>
    </model>
    <include>
      <uri>model://fuel</uri>
      <name>fuel_ramp</name>
      <pose>1.2 0 0.5 0 0 0</pose>
    </include>

  </world>
</sdf>
