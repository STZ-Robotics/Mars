<?xml version="1.0" ?>
<!--
  Verification world: a falling box.

  It exists because empty.sdf only has static bodies, and a subscriber that
  receives constant poses cannot tell "the transport works" from "the engine
  is paused". Here the box's Z has to go down, and that only happens if the
  physics ran AND the message traveled.
-->
<sdf version="1.11">
  <world name="mars">

    <physics name="250hz" type="ignored">
      <max_step_size>0.004</max_step_size>
      <real_time_factor>1.0</real_time_factor>
    </physics>

    <plugin filename="gz-sim-physics-system"
            name="gz::sim::systems::Physics"/>
    <plugin filename="gz-sim-user-commands-system"
            name="gz::sim::systems::UserCommands"/>
    <plugin filename="gz-sim-scene-broadcaster-system"
            name="gz::sim::systems::SceneBroadcaster"/>

    <gravity>0 0 -9.8</gravity>

    <light type="directional" name="sun">
      <pose>0 0 10 0 0 0</pose>
      <diffuse>0.8 0.8 0.8 1</diffuse>
      <direction>-0.5 0.1 -0.9</direction>
    </light>

    <model name="ground_plane">
      <static>true</static>
      <link name="link">
        <collision name="collision">
          <geometry><plane><normal>0 0 1</normal></plane></geometry>
        </collision>
      </link>
    </model>

    <!-- A 20 cm, 2 kg cube dropped from 3 m. With gravity -9.8 it takes
         about 780 ms to hit the floor, plenty of time for a subscriber to see
         Z go down before the impact. -->
    <model name="box">
      <pose>0 0 3 0 0 0</pose>
      <link name="link">
        <inertial>
          <mass>2.0</mass>
          <inertia>
            <ixx>0.01333</ixx><iyy>0.01333</iyy><izz>0.01333</izz>
            <ixy>0</ixy><ixz>0</ixz><iyz>0</iyz>
          </inertia>
        </inertial>
        <collision name="collision">
          <geometry><box><size>0.2 0.2 0.2</size></box></geometry>
        </collision>
        <visual name="visual">
          <geometry><box><size>0.2 0.2 0.2</size></box></geometry>
        </visual>
      </link>
    </model>

  </world>
</sdf>
