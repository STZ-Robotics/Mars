      <!-- The ORDER is the contract: it defines the index inside
           gz.msgs.Actuators.normalized. The robot map lists its own in
           the same order and check.py verifies it.

           Current limit: 58 A on drive (the slip
           current, computed from the mass and the mu) and
           60 A on steering.

           The robot's real reductions: 5.2734375 drive,
           26.091 steering. They come from TunerConstants.java. -->
      <plugin filename="MarsLink" name="mars::MarsLink">
        <actuator joint="fl_drive_joint" motor="kraken_x60" gearRatio="5.2734375" currentLimit="58" neutralMode="brake"/>
        <actuator joint="fl_steer_joint" motor="kraken_x60" gearRatio="26.09090909090909" control="position" currentLimit="60" kp="0.9" kd="0.01"/>
        <actuator joint="fr_drive_joint" motor="kraken_x60" gearRatio="5.2734375" currentLimit="58" neutralMode="brake"/>
        <actuator joint="fr_steer_joint" motor="kraken_x60" gearRatio="26.09090909090909" control="position" currentLimit="60" kp="0.9" kd="0.01"/>
        <actuator joint="bl_drive_joint" motor="kraken_x60" gearRatio="5.2734375" currentLimit="58" neutralMode="brake"/>
        <actuator joint="bl_steer_joint" motor="kraken_x60" gearRatio="26.09090909090909" control="position" currentLimit="60" kp="0.9" kd="0.01"/>
        <actuator joint="br_drive_joint" motor="kraken_x60" gearRatio="5.2734375" currentLimit="58" neutralMode="brake"/>
        <actuator joint="br_steer_joint" motor="kraken_x60" gearRatio="26.09090909090909" control="position" currentLimit="60" kp="0.9" kd="0.01"/>
