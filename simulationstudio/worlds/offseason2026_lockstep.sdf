<?xml version="1.0" ?>
<!--
  Four-module swerve on Kraken X60.

  GENERATED by sim/worlds/gen_swerve.py. To change the robot, change the
  script and run it again, not this file.

  Each module is TWO joints: a steering one about Z (the whole module
  body rotates) and a drive one about the wheel's axle. The wheel link
  hangs from the steering one and not from the chassis, because turning
  the steering has to drag the wheel along with it.

  The steering joints have NO stop and NO spring: with zero torque they
  are free and lateral forces move them, just like a real module with no
  current. The robot code has to close the position loop.
  sim/bridge/fake-robot.py does it with a P so it can be tested.

  The field's limits are collision boxes taken from the official model:
  guardrails, the six driver stations, the towers, the outposts and both
  HUBs. They are turned off with HITBOXES in the generator.
-->
<sdf version="1.11">
  <world name="mars">

    <physics name="250hz" type="ignored">
      <max_step_size>0.004</max_step_size>
      <real_time_factor>0</real_time_factor>
    </physics>

    <plugin filename="gz-sim-physics-system" name="gz::sim::systems::Physics"/>
    <plugin filename="gz-sim-user-commands-system" name="gz::sim::systems::UserCommands"/>
    <plugin filename="gz-sim-scene-broadcaster-system" name="gz::sim::systems::SceneBroadcaster"/>

    <gravity>0 0 -9.8</gravity>

    <light type="directional" name="sun">
      <pose>0 0 10 0 0 0</pose>
      <diffuse>0.8 0.8 0.8 1</diffuse>
      <direction>-0.5 0.1 -0.9</direction>
    </light>

    <model name="ground_plane">
      <static>true</static>
      <link name="link">
        <collision name="collision">
          <geometry><plane><normal>0 0 1</normal></plane></geometry>
          <surface><friction><ode><mu>0.9</mu><mu2>0.9</mu2></ode></friction></surface>
        </collision>
        <visual name="visual">
          <geometry><plane><normal>0 0 1</normal><size>16.54 8.21</size></plane></geometry>
          <material><ambient>0.16 0.17 0.19 1</ambient><diffuse>0.30 0.32 0.36 1</diffuse></material>
        </visual>
      </link>
    </model>

    <!-- The field's PHYSICS: the mesh above has no collision at all,
         so without these boxes the robot drives through the driver
         station wall and the HUB.

         The sizes come from the AABBs of the official glTF's nodes,
         not from a hand-written table. Which ones go in and why the
         trench and the bumps are NOT here: worlds/field_2026.py. -->
