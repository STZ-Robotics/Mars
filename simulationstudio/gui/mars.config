<?xml version="1.0"?>
<!--
  The panels of MARS Simulation Studio's 3D window.

  This is the Gazebo GUI's configuration: each <plugin> is a panel. It can be
  edited by hand, and more can be opened from the window's three-dot menu.

  Chosen for FRC, not the default ones:

    Scene3D              the world. It is the only essential one.
    WorldControl         play / pause / single step
    WorldStats           real-time factor, simulation time, FPS
    EntityTree           the world's tree: models, links, joints, lights
    ComponentInspector   inspect and EDIT whatever is selected
    TransformControl     move and rotate things with the mouse
    ViewAngle            ortho/perspective views and quick framing
    JointPositionController  move joints by hand, to test mechanisms
    Lights               add lights to the scene

  What is NOT here, on purpose:
    Plotting / ImageDisplay      mars-desktop already does that, better
    Shapes / Screenshot / etc    opened from the menu when needed
-->
<window>
  <width>1800</width>
  <height>1000</height>
  <style
    material_theme="Dark"
    material_primary="#e8632a"
    material_accent="#e8632a"
    toolbar_color_light="#1c1f26"
    toolbar_text_color_light="#e6e8ec"
    toolbar_color_dark="#14161a"
    toolbar_text_color_dark="#e6e8ec"
    plugin_toolbar_color_light="#1c1f26"
    plugin_toolbar_text_color_light="#e6e8ec"
    plugin_toolbar_color_dark="#14161a"
    plugin_toolbar_text_color_dark="#e6e8ec"
  />
  <menus>
    <drawer default="false"/>
  </menus>
</window>

<!-- ==================== the scene ==================== -->
<plugin filename="MinimalScene" name="3D View">
  <gz-gui>
    <title>Scene</title>
    <property type="bool" key="showTitleBar">false</property>
    <property type="string" key="state">docked</property>
  </gz-gui>

  <engine>ogre2</engine>
  <scene>scene</scene>
  <ambient_light>0.4 0.4 0.4</ambient_light>
  <background_color>0.08 0.09 0.10</background_color>
  <!-- From a corner and at 3 m, looking at the robot. A swerve measures
       0.72 m: the top-down view from 6 m left it as a dot in the middle of
       the field. From here you can see the modules turn, which is the point. -->
  <camera_pose>-2.6 -2.6 1.9 0 0.45 0.785</camera_pose>
  <camera_clip>
    <near>0.05</near>
    <far>250</far>
  </camera_clip>
</plugin>

<!-- These three draw nothing: they give the scene mouse handling,
     selection highlighting and entity marking. Without them the window shows
     but you cannot orbit or select. -->
<plugin filename="GzSceneManager" name="Scene Manager">
  <gz-gui>
    <property key="resizable" type="bool">false</property>
    <property key="width" type="double">5</property>
    <property key="height" type="double">5</property>
    <property key="state" type="string">floating</property>
    <property key="showTitleBar" type="bool">false</property>
  </gz-gui>
</plugin>

<plugin filename="InteractiveViewControl" name="Interactive view control">
  <gz-gui>
    <property key="resizable" type="bool">false</property>
    <property key="width" type="double">5</property>
    <property key="height" type="double">5</property>
    <property key="state" type="string">floating</property>
    <property key="showTitleBar" type="bool">false</property>
  </gz-gui>
</plugin>

<plugin filename="CameraTracking" name="Camera Tracking">
  <gz-gui>
    <property key="resizable" type="bool">false</property>
    <property key="width" type="double">5</property>
    <property key="height" type="double">5</property>
    <property key="state" type="string">floating</property>
    <property key="showTitleBar" type="bool">false</property>
  </gz-gui>
</plugin>

<!-- ==================== bottom bar ==================== -->
<plugin filename="WorldControl" name="World control">
  <gz-gui>
    <title>Control</title>
    <property type="bool" key="showTitleBar">false</property>
    <property type="bool" key="resizable">false</property>
    <property type="double" key="height">72</property>
    <property type="string" key="state">floating</property>
    <anchors target="3D View">
      <line own="left" target="left"/>
      <line own="bottom" target="bottom"/>
    </anchors>
  </gz-gui>

  <play_pause>true</play_pause>
  <step>true</step>
  <start_paused>false</start_paused>
</plugin>

<plugin filename="WorldStats" name="World stats">
  <gz-gui>
    <title>Stats</title>
    <property type="bool" key="showTitleBar">false</property>
    <property type="bool" key="resizable">false</property>
    <property type="double" key="height">110</property>
    <property type="double" key="width">290</property>
    <property type="string" key="state">floating</property>
    <anchors target="3D View">
      <line own="right" target="right"/>
      <line own="bottom" target="bottom"/>
    </anchors>
  </gz-gui>

  <!-- The real-time factor is not decorative: held below 1.0, the robot
       code runs its 20 ms cycle against slower physics and any PID tuned
       there does not transfer to the real robot. -->
  <sim_time>true</sim_time>
  <real_time>true</real_time>
  <real_time_factor>true</real_time_factor>
  <iterations>true</iterations>
</plugin>

<!-- ==================== toolbar ==================== -->
<plugin filename="TransformControl" name="Transform control">
  <gz-gui>
    <title>Transform</title>
    <property key="resizable" type="bool">false</property>
    <property key="width" type="double">240</property>
    <property key="height" type="double">50</property>
    <property key="state" type="string">floating</property>
    <property key="showTitleBar" type="bool">false</property>
    <property key="cardBackground" type="string">#1c1f26</property>
    <anchors target="3D View">
      <line own="left" target="left"/>
      <line own="top" target="top"/>
    </anchors>
  </gz-gui>
</plugin>

<plugin filename="ViewAngle" name="View angle">
  <gz-gui>
    <title>View</title>
    <property key="resizable" type="bool">false</property>
    <property key="width" type="double">150</property>
    <property key="height" type="double">210</property>
    <property key="state" type="string">floating</property>
    <property key="showTitleBar" type="bool">false</property>
    <property key="cardBackground" type="string">#1c1f26</property>
    <anchors target="3D View">
      <line own="right" target="right"/>
      <line own="top" target="top"/>
    </anchors>
  </gz-gui>
</plugin>

<!-- ==================== side panels ==================== -->
<plugin filename="EntityTree" name="Entity tree">
  <gz-gui>
    <title>World</title>
    <property type="string" key="state">docked</property>
  </gz-gui>
</plugin>

<plugin filename="ComponentInspector" name="Component inspector">
  <gz-gui>
    <title>Inspector</title>
    <property type="string" key="state">docked</property>
  </gz-gui>
</plugin>

<!-- These two go in a tab with the inspector instead of stacked: with
     four panels open at once the side column eats the scene. -->
<plugin filename="JointPositionController" name="Joint position controller">
  <gz-gui>
    <title>Joints</title>
    <property type="string" key="state">docked_collapsed</property>
  </gz-gui>
</plugin>

<plugin filename="Lights" name="Lights">
  <gz-gui>
    <title>Lights</title>
    <property type="string" key="state">docked_collapsed</property>
  </gz-gui>
</plugin>
