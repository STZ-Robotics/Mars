{
  "compilerOptions": {
    "target": "ES2020",
    "useDefineForClassFields": true,
    "lib": ["ES2020", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "skipLibCheck": true,

    /* Bundler mode */
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "noEmit": true,
    "jsx": "react-jsx",

    /* The MARS block is resolved by alias: vite points it at
       src/mars/index.tsx (Full edition) or at src/mars/index.tools.tsx (Tools).
       For tsc it is always the full one — both implementations are checked
       anyway because each one is assigned to `MarsSurface` in its own file, and
       both files are inside `include`. */
    "baseUrl": ".",
    "paths": {
      "@mars": ["./src/mars/index.tsx"]
    },

    /* Linting */
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true
  },
  "include": ["src"],
  "references": [{ "path": "./tsconfig.node.json" }]
}
